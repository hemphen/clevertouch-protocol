{
  "description": "Synthetic radiator-rf frames with their decoding. Addresses are invented (controller f1010203, radiator f1040506); f1100001 is a protocol discovery candidate. Frames start at the length byte, after the AA D391 D391 sync. Valid frames have an intact envelope; those of no known message are unknown, with no roles or values. Each invalid frame breaks one check. They test parsing and encoding, not radio acceptance.",
  "specification": "specification.md",
  "values": {
    "temperature_F": "4B air temperature, degrees Fahrenheit: the raw word / 10, exactly; absent when 084C (unavailable)",
    "setpoint_F": "8A/94 active setpoint, degrees Fahrenheit: the raw word / 10, exactly",
    "mode_raw": "8A/94 mode byte",
    "heat_mode": "Name of the mode code, lowercase (shared values)",
    "temp_type": "Setpoint the mode makes active (shared values)",
    "max_power_pct": "E1 byte 1, the front panel's configured maximum power, percent",
    "duty_1_pct": "E1 byte 2, duty as a share of rated power, percent; absent if either duty byte exceeds 100",
    "duty_2_pct": "E1 byte 3, duty as a share of the limited power, percent; duty_1_pct is it scaled by max_power_pct; absent if either duty byte exceeds 100",
    "on_time_1_s": "DA first word, on-time in seconds, following duty_1_pct",
    "on_time_2_s": "DA second word, on-time in seconds, following duty_2_pct",
    "clock": "B2 controller clock, HH:MM:SS; absent unless hour < 24 and minute, second < 60",
    "boost_time_min": "5B Boost time in minutes, unsigned: the duration the next Boost runs, the time remaining while one runs",
    "heating": "DF byte 2 bit 0, the element heating at this moment"
  },
